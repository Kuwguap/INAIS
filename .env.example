# ============ Core (required for M0: echo bot) ============
TELEGRAM_BOT_TOKEN=            # from @BotFather
OWNER_TELEGRAM_ID=             # your numeric Telegram user id (ask @userinfobot)
RUN_MODE=local                 # local = long polling (dev, no tunnel needed) | web = webhook server (Render)

# ============ Brain (required for M1) ============
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Supabase: use the SESSION pooler URI (port 5432) or the direct connection string.
# The transaction pooler (port 6543) also works — prepared statements are disabled in code.
SUPABASE_DB_URL=               # postgresql://postgres.<ref>:<password>@...supabase.com:5432/postgres
# BRAIN_PROVIDER picks who runs the agent loop:
#   auto      = Anthropic if ANTHROPIC_API_KEY is set, else OpenAI
#   openai    = run EVERYTHING on OpenAI (use this if you have no Claude access)
#   anthropic = force Anthropic
BRAIN_PROVIDER=auto
AGENT_MODEL=claude-sonnet-5
OPENAI_AGENT_MODEL=gpt-5        # the agent model when the brain runs on OpenAI
OPENAI_REASONING_EFFORT=low     # minimal|low|medium|high — GPT-5 thinking time is most of
                                # the wall clock; "low" keeps chat responsive
TRIAGE_MODEL=gpt-5-mini        # cheap OpenAI model for routing + email triage (swap for a nano-tier model if available)
REFLECTION_MODEL=claude-haiku-4-5
EMBEDDING_MODEL=text-embedding-3-small

# ============ Voice (M3) ============
STT_MODEL=gpt-4o-mini-transcribe
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=nova
VOICE_REPLIES=true             # reply to voice notes with a voice bubble (plus text transcript)

# ============ Webhook (M4 — Render injects RENDER_EXTERNAL_URL and PORT automatically) ============
TELEGRAM_WEBHOOK_SECRET=       # long random string; verified on every webhook request
WEBHOOK_SECRET_PATH=           # random URL path segment; leave empty to derive one from the bot token
PORT=10000

# ============ Gmail (M5) ============
GOOGLE_OAUTH_CLIENT_JSON=google_oauth_client.json   # on Render: /etc/secrets/google_oauth_client.json
GMAIL_POLL_SECONDS=60

# ============ Binance (M6) ============
BINANCE_API_KEY=               # READ-ONLY key: "Enable Reading" only, never enable withdrawals
BINANCE_API_SECRET=
BINANCE_SYMBOLS=BTCUSDT,ETHUSDT   # symbols to fetch trade history for
DAILY_SUMMARY_HOUR=8

# ============ Reminders (alarm behaviour) ============
REMINDER_BURST=4               # extra notification pings per reminder (deleted after sending)
REMINDER_NAG_MINUTES=3         # re-ping after this many minutes, doubling each time
REMINDER_MAX_NAGS=3            # stop nagging after this many re-pings

# ============ Planner (M8) ============
MORNING_BRIEF_HOUR=7           # daily brief: calendar + tasks due + reminders + focus stats
CALENDAR_ENABLED=false         # true = Google Calendar tools (re-run authorize_gmail.py after!)

# ============ Study (M9) ============
STUDY_NUDGE_HOUR=17            # evening "today's study focus" ping
REVIEW_CARD_HOUR=9             # daily spaced-repetition card

# ============ GitHub (read-only) ============
GITHUB_TOKEN=                  # fine-grained PAT, READ-ONLY scopes. Never grant write access.
GITHUB_REPOS=                  # comma-separated owner/repo to watch for CI failures
GITHUB_POLL_MINUTES=15

# ============ Sub-agent swarm (M10) ============
SUBAGENT_MODEL=claude-haiku-4-5 # cheap model for parallel specialists
MAX_PARALLEL_SUBAGENTS=4       # concurrency cap for delegated work

# ============ Growing brain (M11) ============
LEARNING_ENABLED=false         # true = research topics on its own while you're away
AUTONOMY_INTERVAL_MINUTES=30   # how often it considers a learning cycle
AUTONOMY_IDLE_MINUTES=45       # only learns after you've been quiet this long
AUTONOMY_TOPICS_PER_CYCLE=2
AUTONOMY_DAILY_BUDGET_USD=1.0  # hard cap on self-directed spend per day
NN_ENABLED=true                # trainable interest/email-importance network
NN_HIDDEN_DIM=32               # capacity ceiling; stays linear until data justifies growth
NN_MIN_EXAMPLES=40             # minimum signal before training runs
SERPER_API_KEY=                # serper.dev — Google results, ~2,500 free/month (preferred)
TAVILY_API_KEY=                # optional alternative
GOOGLE_CSE_API_KEY=            # Google Programmable Search backup (100/day) — needs both:
GOOGLE_CSE_ID=                 # the CX id of a "search the entire web" engine
BRAVE_API_KEY=                 # optional alternative

# ============ Tracking (applications + expenses from email) ============
DEFAULT_CURRENCY=USD           # display currency when a receipt doesn't state one

# ============ Personality & proactivity ============
PROACTIVE_ENABLED=false        # let it start conversations on its own
PROACTIVE_MAX_PER_DAY=3        # hard cap on unprompted messages
QUIET_HOURS_START=22           # never speaks unprompted between these hours
QUIET_HOURS_END=8
VOICE_NOTES_ENABLED=true       # it may choose to reply by voice note
PROACTIVE_MIN_ENGAGEMENT=0.3   # hold back unprompted messages the engagement net rates below this
PERSONA_TONE=warm, direct      # how it carries itself — e.g. playful, formal, deadpan
PERSONA_BREVITY=concise        # concise | balanced | thorough
PERSONA_HUMOUR=true

# ============ Weekly review ============
WEEKLY_REVIEW_DAY=sun          # mon|tue|wed|thu|fri|sat|sun
WEEKLY_REVIEW_HOUR=18

# Weekly digest of unread saved links
READING_DIGEST_DAY=sun         # mon|tue|wed|thu|fri|sat|sun
READING_DIGEST_HOUR=20

# ============ Ops ============
TIMEZONE=UTC                   # e.g. Africa/Nairobi, Europe/Berlin — used by all scheduled jobs
MONTHLY_BUDGET_USD=50          # /usage alarm threshold
LOG_LEVEL=INFO
